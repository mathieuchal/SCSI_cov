# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
venv/
.venv/

# --- raw / derived data (fetched or generated by data/*.sh, data/*.py, eeg_data.py) ---
experiments/data/eeg/
experiments/data/*.csv
experiments/data/*.zip
experiments/data/*.pkl
experiments/data/*.npz

# --- experiment outputs ---
# Keep the small metric/log files (results/**/*.json, *.txt): they are the source of the numbers in
# REPORT.md and are cheap to version. Ignore the heavy binary artifacts (posterior draws, model
# checkpoints) and superseded snapshot folders from earlier baseline runs.
experiments/results/**/*.npz
experiments/results/**/*.pt
experiments/results/pre_nls/
experiments/results/toys/first_pass/

# scratch files
*.bak
*.tmp
.DS_Store
